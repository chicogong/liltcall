{
  "name": "liltcall",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:edge": "wrangler dev --config apps/edge/wrangler.jsonc --var APP_ORIGIN:http://127.0.0.1:5187",
    "dev:edge:test": "wrangler dev --config apps/edge/wrangler.test.jsonc",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:ai": "playwright test --config playwright.ai.config.ts --reporter=list",
    "test:ai:local": "playwright test --config playwright.ai.local.config.ts --reporter=list",
    "test:ai:cloud": "playwright test --config playwright.ai.cloud.config.ts --reporter=list",
    "test:ai:stream": "playwright test --config playwright.ai.stream.config.ts --reporter=list",
    "test:ai:private": "playwright test --config playwright.ai.private.config.ts --reporter=list",
    "test:ai:cloud:private": "playwright test --config playwright.ai.cloud.private.config.ts --reporter=list",
    "test:relay": "LILTCALL_RELAY_TEST=1 playwright test tests/e2e/relay.spec.ts --reporter=list",
    "test:relay:local": "LILTCALL_RELAY_LOCAL=1 playwright test tests/e2e/relay.spec.ts --reporter=list",
    "test:relay:production": "LILTCALL_RELAY_TEST=1 LILTCALL_RELAY_PRODUCTION=1 playwright test tests/e2e/relay.spec.ts --reporter=list",
    "test:relay:production:tcp": "LILTCALL_RELAY_TEST=1 LILTCALL_RELAY_PRODUCTION=1 LILTCALL_RELAY_TCP_ONLY=1 playwright test tests/e2e/relay.spec.ts --reporter=list",
    "smoke:production": "node tests/smoke-production.mjs",
    "typegen": "wrangler types --config apps/edge/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.58.0"
  }
}
